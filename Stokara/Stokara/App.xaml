<Application x:Class="Stokara.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Stokara.ViewModels"
             xmlns:v="clr-namespace:Stokara.Views"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Indeks 0 selalu tema; ThemeService menukarnya saat runtime. -->
                <ResourceDictionary Source="Resources/Themes/Light.xaml"/>
                <ResourceDictionary Source="Resources/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Pemetaan ViewModel → View (navigasi MVVM) -->
            <DataTemplate DataType="{x:Type vm:DashboardViewModel}"><v:DashboardView/></DataTemplate>
            <DataTemplate DataType="{x:Type vm:KasirViewModel}"><v:KasirView/></DataTemplate>
            <DataTemplate DataType="{x:Type vm:RiwayatViewModel}"><v:RiwayatView/></DataTemplate>
            <DataTemplate DataType="{x:Type vm:BarangViewModel}"><v:BarangView/></DataTemplate>
            <DataTemplate DataType="{x:Type vm:StokViewModel}"><v:StokView/></DataTemplate>
            <DataTemplate DataType="{x:Type vm:OpnameViewModel}"><v:OpnameView/></DataTemplate>
            <DataTemplate DataType="{x:Type vm:MitraViewModel}"><v:MitraView/></DataTemplate>
            <DataTemplate DataType="{x:Type vm:KonsinyasiViewModel}"><v:KonsinyasiView/></DataTemplate>
            <DataTemplate DataType="{x:Type vm:LaporanViewModel}"><v:LaporanView/></DataTemplate>
            <DataTemplate DataType="{x:Type vm:PengaturanViewModel}"><v:PengaturanView/></DataTemplate>
            <DataTemplate DataType="{x:Type vm:BantuanViewModel}"><v:BantuanView/></DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
