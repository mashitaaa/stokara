<UserControl x:Class="Stokara.Views.LaporanView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Stokara.Controls">
    <Grid Margin="28,20,28,24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="18"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Filter -->
        <Border Style="{StaticResource Card}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Jenis laporan" Style="{StaticResource TextH3}" Margin="0,0,0,8"/>
                    <ListBox ItemsSource="{Binding JenisLaporan}" SelectedItem="{Binding Jenis}" Margin="-4,0,-4,6">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Value}" FontWeight="SemiBold"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Text="{Binding Petunjuk}" Style="{StaticResource TextMuted}" Margin="0,0,0,12"/>
                    <Separator/>

                    <StackPanel Visibility="{Binding ShowPeriode, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="Periode" Style="{StaticResource TextLabel}"/>
                        <WrapPanel Margin="0,0,0,8" Visibility="{Binding IsRekap, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}">
                            <Button Content="Hari ini" Style="{StaticResource ButtonSecondary}" Padding="9,4" FontSize="12" Margin="0,0,5,5"
                                    Command="{Binding PresetCommand}" CommandParameter="HARI"/>
                            <Button Content="7 hari" Style="{StaticResource ButtonSecondary}" Padding="9,4" FontSize="12" Margin="0,0,5,5"
                                    Command="{Binding PresetCommand}" CommandParameter="7"/>
                            <Button Content="Bulan ini" Style="{StaticResource ButtonSecondary}" Padding="9,4" FontSize="12" Margin="0,0,5,5"
                                    Command="{Binding PresetCommand}" CommandParameter="BULAN"/>
                            <Button Content="Bulan lalu" Style="{StaticResource ButtonSecondary}" Padding="9,4" FontSize="12" Margin="0,0,5,5"
                                    Command="{Binding PresetCommand}" CommandParameter="BULANLALU"/>
                        </WrapPanel>
                        <TextBlock Text="Dari" Style="{StaticResource TextMuted}"/>
                        <DatePicker SelectedDate="{Binding Dari}" Margin="0,2,0,8"/>
                        <StackPanel Visibility="{Binding IsRekap, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}">
                            <TextBlock Text="Sampai" Style="{StaticResource TextMuted}"/>
                            <DatePicker SelectedDate="{Binding Sampai}" Margin="0,2,0,12"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Style="{StaticResource FormField}" Visibility="{Binding ShowKategori, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="Kategori" Style="{StaticResource TextLabel}"/>
                        <ComboBox ItemsSource="{Binding KategoriList}" SelectedItem="{Binding Kategori}" DisplayMemberPath="Nama"/>
                    </StackPanel>
                    <StackPanel Style="{StaticResource FormField}" Visibility="{Binding ShowFilterJenis, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="Jenis" Style="{StaticResource TextLabel}"/>
                        <ComboBox ItemsSource="{Binding FilterJenisOptions}" SelectedValuePath="Key" DisplayMemberPath="Value" SelectedValue="{Binding FilterJenis}"/>
                    </StackPanel>
                    <StackPanel Style="{StaticResource FormField}" Visibility="{Binding ShowStatus, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="Status stok" Style="{StaticResource TextLabel}"/>
                        <ComboBox ItemsSource="{Binding StatusOptions}" SelectedValuePath="Key" DisplayMemberPath="Value" SelectedValue="{Binding Status}"/>
                    </StackPanel>
                    <StackPanel Style="{StaticResource FormField}" Visibility="{Binding ShowBarang, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="Barang" Style="{StaticResource TextLabel}"/>
                        <ComboBox ItemsSource="{Binding BarangList}" SelectedItem="{Binding Barang}" DisplayMemberPath="Nama"/>
                    </StackPanel>
                    <StackPanel Style="{StaticResource FormField}" Visibility="{Binding ShowPenitip, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="Penitip" Style="{StaticResource TextLabel}"/>
                        <ComboBox ItemsSource="{Binding PenitipList}" SelectedItem="{Binding Penitip}" DisplayMemberPath="Nama"/>
                    </StackPanel>
                    <StackPanel Style="{StaticResource FormField}" Visibility="{Binding ShowDusun, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="Dusun (kosong = semua)" Style="{StaticResource TextLabel}"/>
                        <ComboBox ItemsSource="{Binding DusunList}" SelectedItem="{Binding Dusun}"/>
                    </StackPanel>

                    <Button Content="Tampilkan Laporan" Style="{StaticResource ButtonPrimary}" c:UiProps.Icon="&#xE9D2;" Command="{Binding GenerateCommand}"/>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Hasil -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="{Binding Result.Judul, FallbackValue='Pilih laporan lalu tekan Tampilkan'}" Style="{StaticResource TextH2}"/>
                    <TextBlock Text="{Binding Result.Subjudul}" Style="{StaticResource TextMuted}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                    <Button Content="Ekspor CSV/Excel" Style="{StaticResource ButtonSecondary}" c:UiProps.Icon="&#xE896;" Margin="0,0,8,0"
                            Command="{Binding ExportCommand}"/>
                    <Button Content="Cetak" Style="{StaticResource ButtonSecondary}" c:UiProps.Icon="&#xE749;" Command="{Binding PrintCommand}"/>
                </StackPanel>
            </Grid>

            <!-- Ringkasan + grafik -->
            <Grid Grid.Row="1" Margin="0,0,0,14" Visibility="{Binding HasResult, Converter={StaticResource BoolToVis}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="280"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource Card}">
                    <ItemsControl ItemsSource="{Binding Result.Ringkasan}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,0,12">
                                    <TextBlock Text="{Binding Key}" Style="{StaticResource TextMuted}"/>
                                    <TextBlock Text="{Binding Value}" FontSize="18" FontWeight="Bold"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource Card}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="{Binding Result.ChartJudul}" Style="{StaticResource TextH3}" Margin="0,0,0,8"/>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="230">
                            <c:SimpleChart Height="210" Kind="{Binding ChartKind}" Points="{Binding ChartPoints}"
                                           SeriesBrush="{DynamicResource ChartSeries1}" TrackBrush="{DynamicResource BrushSurfaceAlt}"
                                           GridBrush="{DynamicResource BrushChartGrid}" TextBrush="{DynamicResource BrushTextSecondary}"/>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </Grid>

            <!-- Tabel -->
            <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Bottom" Text="{Binding RowCount}" Style="{StaticResource TextMuted}" Margin="14,8"/>
                    <DataGrid ItemsSource="{Binding Table}" AutoGenerateColumns="True" c:UiProps.SmartColumns="True"
                              BorderThickness="0" Background="Transparent" RowHeight="34"/>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
