<Window x:Class="Stokara.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:Stokara.Controls"
        Title="STOKARA | Masuk" Width="920" Height="580" MinWidth="760" MinHeight="520"
        WindowStartupLocation="CenterScreen" FontFamily="Segoe UI"
        Background="{DynamicResource BrushBackground}" Foreground="{DynamicResource BrushTextPrimary}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="5*"/>
            <ColumnDefinition Width="6*"/>
        </Grid.ColumnDefinitions>

        <!-- Panel merek -->
        <Border Background="{DynamicResource BrushSidebar}">
            <Grid Margin="40">
                <Ellipse Width="320" Height="320" Fill="{DynamicResource BrushPrimary}" Opacity="0.18"
                         HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-120,-160,0"/>
                <Ellipse Width="220" Height="220" Fill="{DynamicResource BrushAccent}" Opacity="0.14"
                         HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="-110,0,0,-90"/>
                <StackPanel VerticalAlignment="Center">
                    <Border Width="64" Height="64" CornerRadius="16" Background="{DynamicResource BrushPrimary}" HorizontalAlignment="Left">
                        <TextBlock Text="&#xE719;" FontFamily="Segoe MDL2 Assets" FontSize="30" Foreground="{DynamicResource BrushOnPrimary}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="STOKARA" FontSize="34" FontWeight="Bold" Foreground="{DynamicResource BrushSidebarText}" Margin="0,20,0,0"/>
                    <TextBlock Text="{Binding NamaGerai}" FontSize="16" Foreground="{DynamicResource BrushAccent}" Margin="0,4,0,0"/>
                    <TextBlock Text="Catat stok, layani kasir, salurkan barang subsidi, dan kelola barang titipan. Tetap berjalan tanpa internet."
                               FontSize="14" TextWrapping="Wrap" Foreground="{DynamicResource BrushSidebarMuted}" Margin="0,18,0,0" LineHeight="22"/>
                    <StackPanel Margin="0,26,0,0">
                        <StackPanel Orientation="Horizontal" Margin="0,4">
                            <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource BrushAccent}" VerticalAlignment="Center"/>
                            <TextBlock Text="Kontrol HET dan kuota subsidi" Foreground="{DynamicResource BrushSidebarText}" Margin="10,0,0,0"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,4">
                            <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource BrushAccent}" VerticalAlignment="Center"/>
                            <TextBlock Text="Hutang penitip dihitung otomatis" Foreground="{DynamicResource BrushSidebarText}" Margin="10,0,0,0"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,4">
                            <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource BrushAccent}" VerticalAlignment="Center"/>
                            <TextBlock Text="Setiap perubahan stok dapat ditelusuri" Foreground="{DynamicResource BrushSidebarText}" Margin="10,0,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Form masuk -->
        <Grid Grid.Column="1">
            <StackPanel Width="340" VerticalAlignment="Center">
                <TextBlock Text="Masuk" Style="{StaticResource TextH1}"/>
                <TextBlock Text="Gunakan akun yang diberikan Manajer Gerai." Style="{StaticResource TextMuted}" Margin="0,4,0,26"/>

                <TextBlock Text="Nama pengguna" Style="{StaticResource TextLabel}"/>
                <TextBox x:Name="UserBox" Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                         c:UiProps.Placeholder="mis. kasir" c:UiProps.FocusOnLoad="True" Margin="0,0,0,16"/>

                <TextBlock Text="Kata sandi" Style="{StaticResource TextLabel}"/>
                <Grid Margin="0,0,0,8">
                    <PasswordBox x:Name="PwdBox" PasswordChanged="PwdBox_PasswordChanged"/>
                    <TextBox x:Name="PwdPlain" Visibility="Collapsed" TextChanged="PwdPlain_TextChanged"/>
                </Grid>
                <CheckBox x:Name="ShowPwd" Content="Tampilkan kata sandi" FontSize="13" Checked="ShowPwd_Changed" Unchecked="ShowPwd_Changed"/>

                <Border Background="{DynamicResource BadgeHabisBg}" CornerRadius="8" Padding="12,9" Margin="0,16,0,0"
                        Visibility="{Binding Error, Converter={StaticResource NotEmptyToVis}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE783;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource BadgeHabisFg}" VerticalAlignment="Top" Margin="0,2,10,0"/>
                        <TextBlock Text="{Binding Error}" Foreground="{DynamicResource BadgeHabisFg}" TextWrapping="Wrap" MaxWidth="290"/>
                    </StackPanel>
                </Border>

                <Button x:Name="LoginButton" Content="Masuk" Style="{StaticResource ButtonPrimary}" c:UiProps.Icon="&#xE8FA;"
                        IsDefault="True" Margin="0,22,0,0" Padding="16,12" Click="Login_Click"
                        IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"/>
                <TextBlock Text="Akun contoh: manajer / manajer123 · kasir / kasir123 · gudang / gudang123 · pengurus / pengurus123"
                           Style="{StaticResource TextMuted}" FontSize="11.5" Margin="0,18,0,0"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
