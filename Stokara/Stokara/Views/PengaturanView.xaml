<UserControl x:Class="Stokara.Views.PengaturanView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Stokara.Controls">
    <UserControl.Resources>
        <!-- Daftar sederhana kategori/satuan -->
        <DataTemplate x:Key="LookupItemTemplate">
            <Grid>
                <TextBlock Text="{Binding Nama}" VerticalAlignment="Center"/>
                <ContentControl Style="{StaticResource Badge}" Content="{Binding StatusLabel}" HorizontalAlignment="Right"/>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="28,14,28,24">
        <TabControl SelectedIndex="{Binding Tab}">
            <!-- ================= Profil & tema ================= -->
            <TabItem Header="Profil &amp; Tema">
                <WrapPanel>
                    <Border Style="{StaticResource Card}" Width="400" Margin="0,0,18,18" VerticalAlignment="Top">
                        <StackPanel>
                            <TextBlock Text="Profil" Style="{StaticResource TextH3}" Margin="0,0,0,12"/>
                            <TextBlock Text="Nama" Style="{StaticResource TextMuted}"/>
                            <TextBlock Text="{Binding Nama}" FontWeight="SemiBold" Margin="0,0,0,10"/>
                            <TextBlock Text="Nama pengguna" Style="{StaticResource TextMuted}"/>
                            <TextBlock Text="{Binding Username}" FontWeight="SemiBold" Margin="0,0,0,10"/>
                            <TextBlock Text="Peran" Style="{StaticResource TextMuted}"/>
                            <TextBlock Text="{Binding Peran}" FontWeight="SemiBold" Margin="0,0,0,10"/>
                            <Separator/>
                            <TextBlock Text="Ubah kata sandi" Style="{StaticResource TextH3}" Margin="0,0,0,10"/>
                            <TextBlock Text="Kata sandi lama" Style="{StaticResource TextLabel}"/>
                            <PasswordBox x:Name="PwdOld" Margin="0,0,0,10"/>
                            <TextBlock Text="Kata sandi baru (min. 6 karakter)" Style="{StaticResource TextLabel}"/>
                            <PasswordBox x:Name="PwdNew" Margin="0,0,0,10"/>
                            <TextBlock Text="Ulangi kata sandi baru" Style="{StaticResource TextLabel}"/>
                            <PasswordBox x:Name="PwdRepeat" Margin="0,0,0,14"/>
                            <Button Content="Ubah Kata Sandi" Style="{StaticResource ButtonPrimary}" c:UiProps.Icon="&#xE72E;" Click="ChangePassword_Click"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Width="400" VerticalAlignment="Top">
                        <StackPanel>
                            <TextBlock Text="Tema tampilan" Style="{StaticResource TextH3}" Margin="0,0,0,4"/>
                            <TextBlock Text="Pilihan tema disimpan untuk akun Anda (A-19)." Style="{StaticResource TextMuted}" Margin="0,0,0,12"/>
                            <Border Style="{StaticResource SegmentHost}">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton Style="{StaticResource Segment}" Content="Terang" c:UiProps.Icon="&#xE706;" GroupName="tema"
                                                 IsChecked="{Binding IsLight, Mode=OneWay}" Command="{Binding ThemeCommand}" CommandParameter="Light"/>
                                    <RadioButton Style="{StaticResource Segment}" Content="Gelap" c:UiProps.Icon="&#xE708;" GroupName="tema"
                                                 IsChecked="{Binding IsDark, Mode=OneWay}" Command="{Binding ThemeCommand}" CommandParameter="Dark"/>
                                </StackPanel>
                            </Border>
                            <TextBlock Text="Pratinjau warna" Style="{StaticResource TextLabel}" Margin="0,18,0,8"/>
                            <WrapPanel>
                                <Border Width="44" Height="44" CornerRadius="10" Background="{DynamicResource BrushPrimary}" Margin="0,0,8,8" ToolTip="Primary (bata)"/>
                                <Border Width="44" Height="44" CornerRadius="10" Background="{DynamicResource BrushAccent}" Margin="0,0,8,8" ToolTip="Accent (padi)"/>
                                <Border Width="44" Height="44" CornerRadius="10" Background="{DynamicResource BrushSecondary}" Margin="0,0,8,8" ToolTip="Secondary (daun)"/>
                                <Border Width="44" Height="44" CornerRadius="10" Background="{DynamicResource ChartSeries4}" Margin="0,0,8,8" ToolTip="Subsidi"/>
                            </WrapPanel>
                            <WrapPanel Margin="0,4,0,0">
                                <ContentControl Style="{StaticResource Badge}" Content="Aman" Margin="0,0,6,6"/>
                                <ContentControl Style="{StaticResource Badge}" Content="Menipis" Margin="0,0,6,6"/>
                                <ContentControl Style="{StaticResource Badge}" Content="Habis" Margin="0,0,6,6"/>
                                <ContentControl Style="{StaticResource Badge}" Content="SUBSIDI" Margin="0,0,6,6"/>
                                <ContentControl Style="{StaticResource Badge}" Content="TITIPAN" Margin="0,0,6,6"/>
                            </WrapPanel>
                            <Separator/>
                            <TextBlock Text="Lokasi log teknis" Style="{StaticResource TextLabel}"/>
                            <TextBox Text="{Binding LogFolder, Mode=OneWay}" IsReadOnly="True" FontSize="12"/>
                        </StackPanel>
                    </Border>
                </WrapPanel>
            </TabItem>

            <!-- ================= Kategori & satuan ================= -->
            <TabItem Header="Kategori &amp; Satuan" Visibility="{Binding IsManajer, Converter={StaticResource BoolToVis}}">
                <UniformGrid Columns="2">
                    <Border Style="{StaticResource Card}" Margin="0,0,9,0">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="Kategori" Style="{StaticResource TextH3}" Margin="0,0,0,10"/>
                            <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                                <TextBlock Text="Nama kategori" Style="{StaticResource TextLabel}"/>
                                <TextBox Text="{Binding EditKategori.Nama}" Margin="0,0,0,10"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Content="Aktif/Nonaktif" Style="{StaticResource ButtonGhost}" Margin="0,0,6,0"
                                            Command="{Binding ToggleLookupCommand}" CommandParameter="Kategori"/>
                                    <Button Content="Baru" Style="{StaticResource ButtonSecondary}" Margin="0,0,6,0"
                                            Command="{Binding NewLookupCommand}" CommandParameter="Kategori"/>
                                    <Button Content="Simpan" Style="{StaticResource ButtonPrimary}" c:UiProps.Icon="&#xE74E;"
                                            Command="{Binding SaveLookupCommand}" CommandParameter="Kategori"/>
                                </StackPanel>
                            </StackPanel>
                            <ListBox ItemsSource="{Binding KategoriList}" SelectedItem="{Binding SelectedKategori}" ItemTemplate="{StaticResource LookupItemTemplate}"/>
                        </DockPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Margin="9,0,0,0">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="Satuan" Style="{StaticResource TextH3}" Margin="0,0,0,10"/>
                            <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                                <TextBlock Text="Nama satuan" Style="{StaticResource TextLabel}"/>
                                <TextBox Text="{Binding EditSatuan.Nama}" Margin="0,0,0,10"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Content="Aktif/Nonaktif" Style="{StaticResource ButtonGhost}" Margin="0,0,6,0"
                                            Command="{Binding ToggleLookupCommand}" CommandParameter="Satuan"/>
                                    <Button Content="Baru" Style="{StaticResource ButtonSecondary}" Margin="0,0,6,0"
                                            Command="{Binding NewLookupCommand}" CommandParameter="Satuan"/>
                                    <Button Content="Simpan" Style="{StaticResource ButtonPrimary}" c:UiProps.Icon="&#xE74E;"
                                            Command="{Binding SaveLookupCommand}" CommandParameter="Satuan"/>
                                </StackPanel>
                            </StackPanel>
                            <ListBox ItemsSource="{Binding SatuanList}" SelectedItem="{Binding SelectedSatuan}" ItemTemplate="{StaticResource LookupItemTemplate}"/>
                        </DockPanel>
                    </Border>
                </UniformGrid>
            </TabItem>

            <!-- ================= Pengguna (FR-03) ================= -->
            <TabItem Header="Pengguna" Visibility="{Binding IsManajer, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="18"/>
                        <ColumnDefinition Width="380"/>
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource Card}" Padding="0">
                        <DockPanel>
                            <Grid DockPanel.Dock="Top" Margin="16,12">
                                <TextBlock Text="Akun pengguna" Style="{StaticResource TextH3}" VerticalAlignment="Center"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Content="Reset kata sandi" Style="{StaticResource ButtonGhost}" c:UiProps.Icon="&#xE8D7;" Margin="0,0,6,0"
                                            Command="{Binding ResetPasswordCommand}"/>
                                    <Button Content="Akun Baru" Style="{StaticResource ButtonPrimary}" c:UiProps.Icon="&#xE8FA;" Command="{Binding NewUserCommand}"/>
                                </StackPanel>
                            </Grid>
                            <DataGrid ItemsSource="{Binding Users}" SelectedItem="{Binding SelectedUser}" BorderThickness="0" Background="Transparent">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Nama pengguna" Binding="{Binding Username}" Width="150"/>
                                    <DataGridTextColumn Header="Nama" Binding="{Binding Nama}" Width="*"/>
                                    <DataGridTextColumn Header="Peran" Binding="{Binding RoleLabel}" Width="140"/>
                                    <DataGridTextColumn Header="Login terakhir" Binding="{Binding LastLoginAt, StringFormat='dd/MM/yyyy HH:mm'}" Width="140"/>
                                    <DataGridTemplateColumn Header="Status" Width="100">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate><ContentControl Style="{StaticResource Badge}" Content="{Binding StatusLabel}"/></DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Data akun" Style="{StaticResource TextH3}" Margin="0,0,0,12"/>
                            <StackPanel Style="{StaticResource FormField}">
                                <TextBlock Text="Nama pengguna *" Style="{StaticResource TextLabel}"/>
                                <TextBox Text="{Binding EditUser.Username}" IsReadOnly="{Binding IsNewUser, Converter={StaticResource InverseBool}}"/>
                            </StackPanel>
                            <StackPanel Style="{StaticResource FormField}">
                                <TextBlock Text="Nama lengkap *" Style="{StaticResource TextLabel}"/>
                                <TextBox Text="{Binding EditUser.Nama}"/>
                            </StackPanel>
                            <StackPanel Style="{StaticResource FormField}">
                                <TextBlock Text="Peran" Style="{StaticResource TextLabel}"/>
                                <ComboBox ItemsSource="{Binding RoleOptions}" SelectedValuePath="Key" DisplayMemberPath="Value" SelectedValue="{Binding EditUser.Role}"/>
                            </StackPanel>
                            <StackPanel Style="{StaticResource FormField}" Visibility="{Binding IsNewUser, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="Kata sandi awal (min. 6 karakter) *" Style="{StaticResource TextLabel}"/>
                                <TextBox Text="{Binding NewPassword}"/>
                            </StackPanel>
                            <CheckBox Content="Akun aktif (akun nonaktif tidak dapat login)" IsChecked="{Binding EditUser.IsActive}" Margin="0,0,0,16"/>
                            <Button Content="Simpan Akun" Style="{StaticResource ButtonPrimary}" c:UiProps.Icon="&#xE74E;" Command="{Binding SaveUserCommand}"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ================= Parameter (BR-19) ================= -->
            <TabItem Header="Parameter" Visibility="{Binding IsManajer, Converter={StaticResource BoolToVis}}">
                <WrapPanel>
                    <Border Style="{StaticResource Card}" Width="440" Margin="0,0,18,18" VerticalAlignment="Top">
                        <StackPanel>
                            <TextBlock Text="Profil gerai &amp; parameter" Style="{StaticResource TextH3}" Margin="0,0,0,12"/>
                            <StackPanel Style="{StaticResource FormField}">
                                <TextBlock Text="Nama gerai (tampil di struk) *" Style="{StaticResource TextLabel}"/>
                                <TextBox Text="{Binding NamaGerai}"/>
                            </StackPanel>
                            <StackPanel Style="{StaticResource FormField}">
                                <TextBlock Text="Alamat gerai" Style="{StaticResource TextLabel}"/>
                                <TextBox Text="{Binding AlamatGerai}"/>
                            </StackPanel>
                            <StackPanel Style="{StaticResource FormField}">
                                <TextBlock Text="Telepon" Style="{StaticResource TextLabel}"/>
                                <TextBox Text="{Binding TeleponGerai}"/>
                            </StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <StackPanel Style="{StaticResource FormField}">
                                    <TextBlock Text="Ambang kedaluwarsa (hari)" Style="{StaticResource TextLabel}"/>
                                    <TextBox Text="{Binding AmbangKedaluwarsa, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Style="{StaticResource FormField}">
                                    <TextBlock Text="Baris per halaman" Style="{StaticResource TextLabel}"/>
                                    <TextBox Text="{Binding UkuranHalaman, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                            </Grid>
                            <StackPanel Style="{StaticResource FormField}">
                                <TextBlock Text="Periode kuota (A-04)" Style="{StaticResource TextLabel}"/>
                                <ComboBox ItemsSource="{Binding PeriodeOptions}" SelectedItem="{Binding PeriodeKuota}"/>
                            </StackPanel>
                            <Button Content="Simpan Parameter" Style="{StaticResource ButtonPrimary}" c:UiProps.Icon="&#xE74E;" Command="{Binding SaveParameterCommand}"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Width="440" VerticalAlignment="Top">
                        <StackPanel>
                            <TextBlock Text="HET barang subsidi" Style="{StaticResource TextH3}"/>
                            <TextBlock Text="Ubah HET sesuai ketentuan resmi terbaru. Setiap perubahan tercatat di log aktivitas."
                                       Style="{StaticResource TextMuted}" Margin="0,2,0,12"/>
                            <StackPanel Style="{StaticResource FormField}">
                                <TextBlock Text="Barang subsidi" Style="{StaticResource TextLabel}"/>
                                <ComboBox ItemsSource="{Binding BarangSubsidi}" SelectedItem="{Binding HetBarang}" DisplayMemberPath="Nama"/>
                            </StackPanel>
                            <StackPanel Style="{StaticResource FormField}">
                                <TextBlock Text="HET baru (Rp)" Style="{StaticResource TextLabel}"/>
                                <TextBox Text="{Binding HetBaru, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBlock Text="{Binding HetInfo}" Style="{StaticResource TextMuted}" Margin="0,6,0,0"/>
                            </StackPanel>
                            <Button Content="Simpan HET" Style="{StaticResource ButtonPrimary}" c:UiProps.Icon="&#xE74E;" Command="{Binding SaveHetCommand}"/>
                        </StackPanel>
                    </Border>
                </WrapPanel>
            </TabItem>

            <!-- ================= Log aktivitas (FR-29) ================= -->
            <TabItem Header="Log Aktivitas" Visibility="{Binding CanSeeLog, Converter={StaticResource BoolToVis}}">
                <DockPanel>
                    <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                        <DatePicker SelectedDate="{Binding LogDari}" Width="140" Margin="0,0,8,0"/>
                        <DatePicker SelectedDate="{Binding LogSampai}" Width="140" Margin="0,0,8,0"/>
                        <ComboBox ItemsSource="{Binding LogUsers}" SelectedItem="{Binding LogUser}" DisplayMemberPath="Nama" Width="180" Margin="0,0,8,0"/>
                        <ComboBox ItemsSource="{Binding LogAksiList}" SelectedItem="{Binding LogAksi}" Width="180" Margin="0,0,8,0"/>
                        <Button Content="Tampilkan" Style="{StaticResource ButtonPrimary}" c:UiProps.Icon="&#xE721;" Command="{Binding LoadLogCommand}"/>
                    </WrapPanel>
                    <Border Style="{StaticResource Card}" Padding="0">
                        <DataGrid ItemsSource="{Binding Log}" BorderThickness="0" Background="Transparent">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Waktu" Binding="{Binding Waktu, StringFormat='dd/MM/yyyy HH:mm:ss'}" Width="150"/>
                                <DataGridTextColumn Header="Pengguna" Binding="{Binding Pengguna}" Width="150"/>
                                <DataGridTextColumn Header="Aksi" Binding="{Binding JenisAksi}" Width="140"/>
                                <DataGridTextColumn Header="Entitas" Binding="{Binding Entitas}" Width="130"/>
                                <DataGridTextColumn Header="ID / Dokumen" Binding="{Binding EntitasId}" Width="160"/>
                                <DataGridTextColumn Header="Keterangan" Binding="{Binding Keterangan}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </DockPanel>
            </TabItem>

            <!-- ================= Backup & restore (FR-33) ================= -->
            <TabItem Header="Backup &amp; Restore" Visibility="{Binding IsManajer, Converter={StaticResource BoolToVis}}">
                <Border Style="{StaticResource Card}" Width="560" HorizontalAlignment="Left" VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="Cadangkan dan pulihkan database" Style="{StaticResource TextH3}"/>
                        <TextBlock Text="{Binding BackupInfo}" Style="{StaticResource TextMuted}" Margin="0,4,0,16"/>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Buat Backup" Style="{StaticResource ButtonPrimary}" c:UiProps.Icon="&#xE896;" Margin="0,0,10,0" Command="{Binding BackupCommand}"/>
                            <Button Content="Pulihkan dari Backup" Style="{StaticResource ButtonDanger}" c:UiProps.Icon="&#xE777;" Command="{Binding RestoreCommand}"/>
                        </StackPanel>
                        <Border Background="{DynamicResource BadgeMenipisBg}" CornerRadius="8" Padding="12,9" Margin="0,16,0,0">
                            <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource BadgeMenipisFg}"
                                       Text="Pemulihan mengganti seluruh data dengan isi file backup dan semua pengguna akan keluar. Lakukan saat gerai tutup."/>
                        </Border>
                    </StackPanel>
                </Border>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
