<UserControl x:Class="Stokara.Views.BarangView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Stokara.Controls">
    <Grid Margin="28,20,28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- Filter & aksi: filter di kiri (boleh turun baris), tombol aksi di kanan; keduanya tidak saling menimpa -->
        <Grid Grid.ColumnSpan="2" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <WrapPanel VerticalAlignment="Center">
                <Grid Width="260" Margin="0,0,10,8">
                    <TextBox x:Name="SearchBox" Text="{Binding Keyword, UpdateSourceTrigger=PropertyChanged}"
                             c:UiProps.Placeholder="Cari nama, SKU, barcode" Padding="36,7,10,7"/>
                    <TextBlock Text="&#xE721;" Style="{StaticResource TextIcon}" FontSize="14" Margin="12,0,0,0" HorizontalAlignment="Left" IsHitTestVisible="False"/>
                </Grid>
                <ComboBox ItemsSource="{Binding Kategori}" SelectedItem="{Binding SelectedKategori}" DisplayMemberPath="Nama" Width="170" Margin="0,0,10,8"/>
                <ComboBox ItemsSource="{Binding JenisOptions}" SelectedValuePath="Key" DisplayMemberPath="Value" SelectedValue="{Binding Jenis}"
                          Width="140" Margin="0,0,10,8"/>
                <ComboBox ItemsSource="{Binding StatusOptions}" SelectedValuePath="Key" DisplayMemberPath="Value" SelectedValue="{Binding Status}"
                          Width="140" Margin="0,0,10,8"/>
                <CheckBox Content="Tampilkan nonaktif" IsChecked="{Binding IncludeInactive}" VerticalAlignment="Center" Margin="0,0,10,8"/>
            </WrapPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="8,0,0,0">
                <Button Style="{StaticResource ButtonSecondary}" c:UiProps.Icon="&#xE8D8;" Margin="0,0,8,0" Padding="10,8"
                        ToolTip="{Binding ToggleActiveLabel}" Command="{Binding ToggleActiveCommand}"
                        Visibility="{Binding CanDeactivate, Converter={StaticResource BoolToVis}}"/>
                <Button Style="{StaticResource ButtonSecondary}" c:UiProps.Icon="&#xE70F;" Margin="0,0,8,0" Padding="10,8"
                        ToolTip="Ubah barang terpilih" Command="{Binding EditCommand}"
                        Visibility="{Binding CanEdit, Converter={StaticResource BoolToVis}}"/>
                <Button Content="Tambah" Style="{StaticResource ButtonPrimary}" c:UiProps.Icon="&#xE710;" ToolTip="Tambah barang (Ctrl+N)"
                        Command="{Binding AddCommand}" Visibility="{Binding CanEdit, Converter={StaticResource BoolToVis}}"/>
                <Button Style="{StaticResource ButtonIcon}" c:UiProps.Icon="&#xE89F;" Margin="6,0,0,0" ToolTip="Tampilkan/sembunyikan kartu stok"
                        Command="{Binding ToggleDetailCommand}"/>
            </StackPanel>
        </Grid>

        <!-- Tabel barang -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0">
            <DockPanel>
                <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="0,1,0,0" Padding="14,8">
                    <Grid>
                        <TextBlock Text="{Binding PageInfo}" Style="{StaticResource TextMuted}" VerticalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Style="{StaticResource ButtonSecondary}" c:UiProps.Icon="&#xE76B;" Content="Sebelumnya" Padding="12,6"
                                    Command="{Binding PrevCommand}" Margin="0,0,8,0"/>
                            <Button Style="{StaticResource ButtonSecondary}" Content="Berikutnya" Padding="12,6" Command="{Binding NextCommand}"/>
                        </StackPanel>
                    </Grid>
                </Border>
                <Grid>
                    <DataGrid x:Name="BarangGrid" ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}" BorderThickness="0" Background="Transparent"
                              Sorting="Grid_Sorting" MouseDoubleClick="Grid_MouseDoubleClick">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Nama barang" SortMemberPath="Nama" Width="*" MinWidth="200">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Nama}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Nama}"/>
                                            <TextBlock Style="{StaticResource TextMuted}" FontSize="11.5" TextTrimming="CharacterEllipsis">
                                                <Run Text="{Binding SKU, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding KategoriNama, Mode=OneWay}"/>
                                            </TextBlock>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Jenis" SortMemberPath="JenisLabel" Width="Auto" MinWidth="86">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ContentControl Style="{StaticResource Badge}" Content="{Binding JenisLabel}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Stok" SortMemberPath="StokSaatIni" Width="Auto" MinWidth="90">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock VerticalAlignment="Center">
                                            <Run Text="{Binding StokSaatIni, Mode=OneWay, StringFormat='#,0.##'}" FontWeight="SemiBold"/>
                                            <Run Text="{Binding SatuanNama, Mode=OneWay}" Foreground="{DynamicResource BrushTextSecondary}"/>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Status" SortMemberPath="StatusStok" Width="Auto" MinWidth="90">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <ContentControl Style="{StaticResource Badge}" Content="{Binding StatusStok}"/>
                                            <ContentControl Style="{StaticResource Badge}" Content="NONAKTIF" Margin="4,0,0,0"
                                                            Visibility="{Binding IsActive, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Harga umum" Binding="{Binding HargaUmum, Converter={StaticResource Rupiah}}" SortMemberPath="HargaUmum" Width="Auto" MinWidth="100"/>
                            <DataGridTextColumn Header="Harga anggota" Binding="{Binding HargaAnggota, Converter={StaticResource Rupiah}}" SortMemberPath="HargaAnggota" Width="Auto" MinWidth="100"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"
                                Visibility="{Binding Items.Count, Converter={StaticResource NotEmptyToVis}, ConverterParameter=Invert}">
                        <TextBlock Text="&#xE7B8;" FontFamily="Segoe MDL2 Assets" FontSize="40" HorizontalAlignment="Center" Foreground="{DynamicResource BrushTextDisabled}"/>
                        <TextBlock Text="Tidak ada barang yang cocok" Style="{StaticResource TextH3}" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                        <TextBlock Text="Ubah kata kunci atau filter." Style="{StaticResource TextMuted}" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </DockPanel>
        </Border>

        <!-- Detail & kartu stok (FR-15) -->
        <Border Grid.Row="1" Grid.Column="1" Width="340" Margin="16,0,0,0" Style="{StaticResource Card}"
                Visibility="{Binding DetailOpen, Converter={StaticResource BoolToVis}}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="{Binding Selected.Nama, FallbackValue='Pilih barang'}" Style="{StaticResource TextH3}" TextWrapping="Wrap"/>
                    <WrapPanel Margin="0,6,0,12">
                        <ContentControl Style="{StaticResource Badge}" Content="{Binding Selected.JenisLabel}" Margin="0,0,6,0"/>
                        <ContentControl Style="{StaticResource Badge}" Content="{Binding Selected.StatusStok}" Margin="0,0,6,0"/>
                        <TextBlock Style="{StaticResource TextMuted}" VerticalAlignment="Center">
                            <Run Text="{Binding Selected.SKU, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding Selected.Barcode, Mode=OneWay}"/>
                        </TextBlock>
                    </WrapPanel>
                    <TextBlock Style="{StaticResource TextMuted}" Margin="0,-4,0,10"
                               Visibility="{Binding Selected.IsSubsidi, Converter={StaticResource BoolToVis}}">
                        <Run Text="HET"/> <Run Text="{Binding Selected.HET, Mode=OneWay, Converter={StaticResource Rupiah}}" FontWeight="SemiBold"/>
                    </TextBlock>
                    <TextBlock Style="{StaticResource TextMuted}" Margin="0,-4,0,10"
                               Visibility="{Binding Selected.IsTitipan, Converter={StaticResource BoolToVis}}">
                        <Run Text="Penitip"/> <Run Text="{Binding Selected.PenitipNama, Mode=OneWay}" FontWeight="SemiBold"/>
                        <Run Text="· harga titip"/> <Run Text="{Binding Selected.HargaTitip, Mode=OneWay, Converter={StaticResource Rupiah}}" FontWeight="SemiBold"/>
                    </TextBlock>
                    <UniformGrid Columns="2" Margin="0,0,0,12">
                        <StackPanel Margin="0,0,8,8">
                            <TextBlock Text="Stok saat ini" Style="{StaticResource TextMuted}"/>
                            <TextBlock FontSize="18" FontWeight="Bold">
                                <Run Text="{Binding Selected.StokSaatIni, Mode=OneWay, StringFormat='#,0.##'}"/>
                                <Run Text="{Binding Selected.SatuanNama, Mode=OneWay}" FontSize="13" FontWeight="Normal"/>
                            </TextBlock>
                        </StackPanel>
                        <StackPanel Margin="0,0,0,8">
                            <TextBlock Text="Stok minimum" Style="{StaticResource TextMuted}"/>
                            <TextBlock Text="{Binding Selected.StokMinimum, StringFormat='#,0.##'}" FontSize="18" FontWeight="Bold"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,8,0" Visibility="{Binding ShowHpp, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="HPP rata-rata" Style="{StaticResource TextMuted}"/>
                            <TextBlock Text="{Binding Selected.HargaPokokRata, Converter={StaticResource Rupiah}}" FontWeight="SemiBold"/>
                        </StackPanel>
                        <StackPanel Visibility="{Binding ShowHpp, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="Nilai persediaan" Style="{StaticResource TextMuted}"/>
                            <TextBlock Text="{Binding Selected.NilaiPersediaan, Converter={StaticResource Rupiah}}" FontWeight="SemiBold"/>
                        </StackPanel>
                    </UniformGrid>
                    <Separator/>
                    <TextBlock Text="Kartu stok" Style="{StaticResource TextH3}"/>
                    <Grid Margin="0,8,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <DatePicker SelectedDate="{Binding KartuDari}"/>
                        <DatePicker Grid.Column="2" SelectedDate="{Binding KartuSampai}"/>
                        <Button Grid.Column="3" Style="{StaticResource ButtonIcon}" c:UiProps.Icon="&#xE72C;" Margin="6,0,0,0"
                                ToolTip="Tampilkan" Command="{Binding KartuStokCommand}"/>
                    </Grid>
                    <Grid Margin="0,0,0,6">
                        <TextBlock Text="Saldo awal periode" Style="{StaticResource TextMuted}"/>
                        <TextBlock Text="{Binding SaldoAwal, StringFormat='#,0.##'}" HorizontalAlignment="Right" FontWeight="SemiBold"/>
                    </Grid>
                </StackPanel>
                <Border DockPanel.Dock="Bottom" Background="{DynamicResource BrushSurfaceAlt}" CornerRadius="8" Padding="10,8" Margin="0,8,0,0">
                    <Grid>
                        <TextBlock Text="Saldo akhir (= stok barang)" Style="{StaticResource TextMuted}"/>
                        <TextBlock Text="{Binding SaldoAkhir, StringFormat='#,0.##'}" HorizontalAlignment="Right" FontWeight="Bold"/>
                    </Grid>
                </Border>
                <DataGrid ItemsSource="{Binding Kartu}" RowHeight="46" FontSize="12.5">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="Tanggal / Dokumen" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel VerticalAlignment="Center" ToolTip="{Binding Keterangan}">
                                        <TextBlock Text="{Binding JenisLabel}" FontWeight="SemiBold"/>
                                        <TextBlock Style="{StaticResource TextMuted}" FontSize="11">
                                            <Run Text="{Binding Tanggal, Mode=OneWay, StringFormat='dd/MM HH:mm'}"/><Run Text=" · "/><Run Text="{Binding NomorDokumen, Mode=OneWay}"/>
                                        </TextBlock>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Masuk" Binding="{Binding Masuk, StringFormat='#,0.##'}" Width="58"/>
                        <DataGridTextColumn Header="Keluar" Binding="{Binding Keluar, StringFormat='#,0.##'}" Width="58"/>
                        <DataGridTextColumn Header="Saldo" Binding="{Binding SaldoSetelah, StringFormat='#,0.##'}" Width="58"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
