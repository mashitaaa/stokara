<Window x:Class="Stokara.Views.ReceiptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:Stokara.Controls"
        Title="Pratinjau Struk" Width="420" Height="680" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        ResizeMode="CanResize" FontFamily="Segoe UI"
        Background="{DynamicResource BrushBackground}" Foreground="{DynamicResource BrushTextPrimary}">
    <DockPanel Margin="18">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <TextBlock x:Name="Heading" Style="{StaticResource TextH3}"/>
            <TextBlock Text="Periksa struk sebelum dicetak. Tekan Esc untuk menutup." Style="{StaticResource TextMuted}"/>
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Tutup" Style="{StaticResource ButtonSecondary}" IsCancel="True" Margin="0,0,10,0"/>
            <Button Content="Cetak" Style="{StaticResource ButtonPrimary}" c:UiProps.Icon="&#xE749;" IsDefault="True" Click="Print_Click"/>
        </StackPanel>
        <Border Background="White" CornerRadius="8" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1">
            <FlowDocumentScrollViewer x:Name="Viewer" VerticalScrollBarVisibility="Auto" IsToolBarVisible="False"/>
        </Border>
    </DockPanel>
</Window>
