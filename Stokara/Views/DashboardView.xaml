<UserControl x:Class="Stokara.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Stokara.Controls">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,22,28,28">
            <!-- Sapaan -->
            <Grid Margin="0,0,0,18">
                <StackPanel>
                    <TextBlock Text="{Binding Sapaan}" Style="{StaticResource PageTitle}"/>
                    <TextBlock Text="{Binding Tanggal}" Style="{StaticResource TextMuted}" FontSize="13.5"/>
                </StackPanel>
                <Button HorizontalAlignment="Right" VerticalAlignment="Center" Content="Muat ulang" Style="{StaticResource ButtonSecondary}"
                        c:UiProps.Icon="&#xE72C;" Command="{Binding RefreshCommand}"/>
            </Grid>

            <!-- Kartu statistik (FR-04) -->
            <UniformGrid Columns="4" Margin="-7,0,-7,0">
                <c:StatCard Margin="7" Title="Penjualan Hari Ini" Format="Rupiah" Icon="&#xE8C7;"
                            Value="{Binding Stats.PenjualanHariIni}" Subtitle="{Binding PenjualanSubtitle}"
                            Visibility="{Binding ShowSales, Converter={StaticResource BoolToVis}}"/>
                <c:StatCard Margin="7" Title="Nilai Persediaan" Format="Rupiah" Icon="&#xE7B8;" Accent="{DynamicResource BrushSecondary}"
                            Value="{Binding Stats.NilaiPersediaan}" Subtitle="Hanya barang milik koperasi"
                            Visibility="{Binding ShowFinance, Converter={StaticResource BoolToVis}}"/>
                <c:StatCard Margin="7" Title="Stok Kritis" Icon="&#xE7BA;" Accent="{DynamicResource BrushWarning}"
                            Value="{Binding Stats.StokKritis}" Subtitle="{Binding Stats.JumlahBarang, StringFormat='dari {0} jenis barang aktif'}"/>
                <c:StatCard Margin="7" Title="Hutang ke Penitip" Format="Rupiah" Icon="&#xE8F1;" Accent="{DynamicResource ChartSeries4}"
                            Value="{Binding Stats.HutangPenitip}" Subtitle="Sisa yang belum dibayar"
                            Visibility="{Binding ShowFinance, Converter={StaticResource BoolToVis}}"/>
                <c:StatCard Margin="7" Title="{Binding PeriodeKuota, StringFormat='Subsidi Tersalur ({0})'}" Icon="&#xE9D9;" Accent="{DynamicResource ChartSeries4}"
                            Value="{Binding Stats.SubsidiTersalur}" Subtitle="{Binding SubsidiSubtitle}"
                            Visibility="{Binding ShowFinance, Converter={StaticResource BoolToVis}}"/>
                <c:StatCard Margin="7" Title="Perkiraan Kedaluwarsa" Icon="&#xE787;" Accent="{DynamicResource BrushDanger}"
                            Value="{Binding Stats.PerkiraanKedaluwarsa}" Subtitle="Dalam ambang peringatan"
                            Visibility="{Binding ShowExpiry, Converter={StaticResource BoolToVis}}"/>
            </UniformGrid>

            <!-- Grafik (FR-05) -->
            <Grid Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="2*"/>
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource Card}" Visibility="{Binding ShowSales, Converter={StaticResource BoolToVis}}">
                    <DockPanel>
                        <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                            <TextBlock Text="{Binding GrafikJudul}" Style="{StaticResource TextH3}" VerticalAlignment="Center"/>
                            <Border Style="{StaticResource SegmentHost}" HorizontalAlignment="Right">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton Style="{StaticResource Segment}" Content="7 hari" Padding="12,5" FontSize="12.5" GroupName="hari"
                                                 IsChecked="{Binding Hari, Converter={StaticResource EqualsConv}, ConverterParameter=7, Mode=OneWay}"
                                                 Command="{Binding SetHariCommand}" CommandParameter="7"/>
                                    <RadioButton Style="{StaticResource Segment}" Content="30 hari" Padding="12,5" FontSize="12.5" GroupName="hari"
                                                 IsChecked="{Binding Hari, Converter={StaticResource EqualsConv}, ConverterParameter=30, Mode=OneWay}"
                                                 Command="{Binding SetHariCommand}" CommandParameter="30"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                        <c:SimpleChart Height="250" Kind="Line" Points="{Binding Penjualan}" ValuePrefix="Rp "
                                       SeriesBrush="{DynamicResource ChartSeries1}" TrackBrush="{DynamicResource BrushSurface}"
                                       GridBrush="{DynamicResource BrushChartGrid}" TextBrush="{DynamicResource BrushTextSecondary}"/>
                    </DockPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource Card}">
                    <Grid>
                        <!-- Kasir: daftar stok kritis; peran lain: produk terlaris -->
                        <DockPanel Visibility="{Binding ShowAktivitas, Converter={StaticResource BoolToVis}}">
                            <TextBlock DockPanel.Dock="Top" Text="Produk terlaris (30 hari)" Style="{StaticResource TextH3}" Margin="0,0,0,10"/>
                            <c:SimpleChart Height="250" Kind="Bar" Points="{Binding Terlaris}"
                                           SeriesBrush="{DynamicResource ChartSeries2}" TrackBrush="{DynamicResource BrushSurface}"
                                           GridBrush="{DynamicResource BrushChartGrid}" TextBrush="{DynamicResource BrushTextSecondary}"/>
                        </DockPanel>
                        <DockPanel Visibility="{Binding ShowAktivitas, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}">
                            <TextBlock DockPanel.Dock="Top" Text="Tips kasir" Style="{StaticResource TextH3}" Margin="0,0,0,10"/>
                            <StackPanel>
                                <TextBlock Style="{StaticResource TextBody}" Margin="0,0,0,8" Text="• Tekan F2 kapan saja untuk membuka Kasir."/>
                                <TextBlock Style="{StaticResource TextBody}" Margin="0,0,0,8" Text="• Scan barcode lalu Enter untuk menambah barang."/>
                                <TextBlock Style="{StaticResource TextBody}" Margin="0,0,0,8" Text="• Ctrl+S untuk membayar, Esc untuk menutup saran."/>
                                <TextBlock Style="{StaticResource TextBody}" Text="• Tutup kasir di menu Riwayat Transaksi sebelum pulang."/>
                            </StackPanel>
                        </DockPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- Panel peringatan & kuota -->
            <Grid Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Stok kritis (FR-06) -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBlock Text="&#xE7BA;" Style="{StaticResource TextIcon}" Foreground="{DynamicResource BrushWarning}" Margin="0,0,8,0"/>
                            <TextBlock Text="Stok kritis" Style="{StaticResource TextH3}"/>
                        </StackPanel>
                        <TextBlock Text="Semua stok dalam batas aman." Style="{StaticResource TextMuted}"
                                   Visibility="{Binding StokKritis, Converter={StaticResource NotEmptyToVis}, ConverterParameter=Invert}"/>
                        <ItemsControl ItemsSource="{Binding StokKritis}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,5">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Nama}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Keterangan}" Style="{StaticResource TextMuted}" FontSize="12"/>
                                        </StackPanel>
                                        <ContentControl Grid.Column="1" Style="{StaticResource Badge}" Content="{Binding Status}"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Perkiraan kedaluwarsa (FR-07, A-09) -->
                <Border Grid.Column="2" Style="{StaticResource Card}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <TextBlock Text="&#xE787;" Style="{StaticResource TextIcon}" Foreground="{DynamicResource BrushDanger}" Margin="0,0,8,0"/>
                            <TextBlock Text="Perkiraan kedaluwarsa" Style="{StaticResource TextH3}"/>
                        </StackPanel>
                        <TextBlock Text="Estimasi tanpa batch: sisa stok dianggap dari penerimaan terbaru." Style="{StaticResource TextMuted}"
                                   FontSize="11.5" Margin="0,0,0,8"/>
                        <TextBlock Text="Tidak ada barang dalam ambang peringatan." Style="{StaticResource TextMuted}"
                                   Visibility="{Binding Kedaluwarsa, Converter={StaticResource NotEmptyToVis}, ConverterParameter=Invert}"/>
                        <ItemsControl ItemsSource="{Binding Kedaluwarsa}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,5">
                                        <TextBlock Text="{Binding Nama}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Keterangan}" Style="{StaticResource TextMuted}" FontSize="12"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Kuota subsidi & aktivitas -->
                <Border Grid.Column="4" Style="{StaticResource Card}" Visibility="{Binding ShowAktivitas, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBlock Text="{Binding PeriodeKuota, StringFormat='Kuota subsidi terpakai · {0}'}" Style="{StaticResource TextH3}" Margin="0,0,0,10"/>
                        <c:SimpleChart Kind="Progress" Points="{Binding Kuota}" MinHeight="60"
                                       SeriesBrush="{DynamicResource ChartSeries4}" TrackBrush="{DynamicResource BrushSurfaceAlt}"
                                       TextBrush="{DynamicResource BrushTextPrimary}"/>
                        <Separator/>
                        <TextBlock Text="Aktivitas terbaru" Style="{StaticResource TextH3}" Margin="0,0,0,8"/>
                        <ItemsControl ItemsSource="{Binding Aktivitas}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Ellipse Width="7" Height="7" Fill="{DynamicResource BrushAccent}" VerticalAlignment="Top" Margin="0,7,10,0"/>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock TextTrimming="CharacterEllipsis">
                                                <Run Text="{Binding JenisAksi, Mode=OneWay}" FontWeight="SemiBold"/>
                                                <Run Text="{Binding EntitasId, Mode=OneWay}"/>
                                            </TextBlock>
                                            <TextBlock Style="{StaticResource TextMuted}" FontSize="11.5">
                                                <Run Text="{Binding Pengguna, Mode=OneWay}"/>
                                                <Run Text="·"/>
                                                <Run Text="{Binding Waktu, Mode=OneWay, StringFormat='dd/MM HH:mm'}"/>
                                            </TextBlock>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
