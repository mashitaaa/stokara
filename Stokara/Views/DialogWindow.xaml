<Window x:Class="Stokara.Views.DialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:Stokara.Controls"
        Width="460" SizeToContent="Height" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
        FontFamily="Segoe UI" Foreground="{DynamicResource BrushTextPrimary}">
    <Border Background="{DynamicResource BrushSurface}" CornerRadius="14" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" Margin="14">
        <Border.Effect>
            <DropShadowEffect BlurRadius="26" ShadowDepth="4" Opacity="0.28" Color="#000000"/>
        </Border.Effect>
        <StackPanel Margin="26,22,26,20">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <Border x:Name="IconHost" Width="36" Height="36" CornerRadius="18" Background="{DynamicResource BadgeMenipisBg}">
                    <TextBlock x:Name="IconText" Text="&#xE9CE;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                               Foreground="{DynamicResource BadgeMenipisFg}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock x:Name="TitleText" Style="{StaticResource TextH3}" FontSize="17" Margin="12,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock x:Name="MessageText" Style="{StaticResource TextBody}" LineHeight="21"/>
            <StackPanel x:Name="InputPanel" Margin="0,16,0,0" Visibility="Collapsed">
                <TextBlock x:Name="InputLabel" Style="{StaticResource TextLabel}"/>
                <TextBox x:Name="InputBox" TextChanged="InputBox_TextChanged"/>
                <TextBlock x:Name="InputError" Text="Wajib diisi." Foreground="{DynamicResource BrushDanger}" FontSize="12" Margin="2,4,0,0" Visibility="Collapsed"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
                <Button x:Name="CancelButton" Content="Batal" Style="{StaticResource ButtonSecondary}" IsCancel="True" Margin="0,0,10,0"/>
                <Button x:Name="OkButton" Style="{StaticResource ButtonPrimary}" IsDefault="True" Click="Ok_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
